# -----------------------------------------------------------------------------
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in your values.
# NEVER commit terraform.tfvars to version control — it contains secrets.
# -----------------------------------------------------------------------------

# --- Vault (HCP) ---
vault_addr      = "https://<your-cluster-id>.z1.hashicorp.cloud:8200"
vault_token     = "<your-vault-token>"          # sensitive — prefer TF_VAR_vault_token env var
vault_namespace = "admin"

# --- IBM Cloud ---
region            = "us-south"
prefix            = "demo"
name              = "vpc"
resource_group_id = "<your-resource-group-id>"

# Get image IDs: ibmcloud is images --visibility public --region us-south
image_id     = "r006-988caa8b-5a05-4b73-9f97-3c35df9e40c6"   # ubuntu-24-04-minimal
machine_type = "cx2-2x4"

# SSH key pair is auto-generated by ssh_key.tf and stored in Vault at vsi-private-key
# No ssh_key_ids needed.

user_data    = ""
resource_tags = ["env:demo", "owner:yourname"]
