# -----------------------------------------------------------------------------
# VPC — public subnet in zone-1 with a public gateway
# Uses: terraform-ibm-modules/landing-zone-vpc/ibm v10.0.11
# -----------------------------------------------------------------------------
module "vpc" {
  source  = "terraform-ibm-modules/landing-zone-vpc/ibm"
  version = "10.0.11"

  name              = var.name
  region            = var.region
  resource_group_id = var.resource_group_id
  prefix            = var.prefix

  # Single public subnet in zone-1 with a public gateway attached
  subnets = {
    zone-1 = [
      {
        name           = "public-subnet"
        cidr           = "10.10.10.0/24"
        acl_name       = "vpc-acl"
        public_gateway = true
        no_addr_prefix = false
      }
    ]
  }

  use_public_gateways = {
    zone-1 = true
    zone-2 = false
    zone-3 = false
  }

  # Network ACL — allow HTTP inbound from internet + all outbound
  network_acls = [
    {
      name                         = "vpc-acl"
      add_ibm_cloud_internal_rules = true
      add_vpc_connectivity_rules   = true
      prepend_ibm_rules            = true
      rules = [
        {
          name        = "allow-http-inbound-internet"
          action      = "allow"
          direction   = "inbound"
          source      = "0.0.0.0/0"
          destination = "10.10.10.0/24"
          protocol    = "tcp"
          port_min    = 80
          port_max    = 80
        },
        {
          name        = "allow-http-return-outbound"
          action      = "allow"
          direction   = "outbound"
          source      = "10.10.10.0/24"
          destination = "0.0.0.0/0"
          protocol    = "tcp"
          source_port_min = 80
          source_port_max = 80
        },
        {
          name        = "allow-ephemeral-outbound"
          action      = "allow"
          direction   = "outbound"
          source      = "10.10.10.0/24"
          destination = "0.0.0.0/0"
          protocol    = "tcp"
          source_port_min = 1024
          source_port_max = 65535
        },
        {
          name        = "allow-ephemeral-inbound"
          action      = "allow"
          direction   = "inbound"
          source      = "0.0.0.0/0"
          destination = "10.10.10.0/24"
          protocol    = "tcp"
          port_min    = 1024
          port_max    = 65535
        }
      ]
    }
  ]

  # Security group rules on the default VPC security group
  security_group_rules = [
    {
      name      = "allow-ssh-inbound"
      direction = "inbound"
      remote    = "0.0.0.0/0"
      protocol  = "tcp"
      port_min  = 22
      port_max  = 22
    },
    {
      name      = "allow-http-inbound"
      direction = "inbound"
      remote    = "0.0.0.0/0"
      protocol  = "tcp"
      port_min  = 80
      port_max  = 80
    },
    {
      name      = "allow-all-outbound"
      direction = "outbound"
      remote    = "0.0.0.0/0"
    }
  ]

  resource_tags = var.resource_tags
}

# -----------------------------------------------------------------------------
# VSI — one instance in the public subnet with Nginx + load balancer
# Uses: terraform-ibm-modules/landing-zone-vsi/ibm v8.2.0
# SSH key is auto-generated by ssh_key.tf and stored in Vault.
# -----------------------------------------------------------------------------
module "vsi" {
  source  = "terraform-ibm-modules/landing-zone-vsi/ibm"
  version = "8.2.0"

  prefix            = var.prefix
  resource_group_id = var.resource_group_id
  vpc_id            = module.vpc.vpc_id
  image_id          = var.image_id
  machine_type      = var.machine_type
  vsi_per_subnet    = 1
  ssh_key_ids       = [ibm_is_ssh_key.vsi.id]
  user_data         = local.nginx_user_data

  # Attach VSI to the public subnet created above
  subnets = [
    {
      name = "public-subnet"
      id   = module.vpc.subnet_detail_map["zone-1"][0].id
      zone = "${var.region}-1"
      cidr = "10.10.10.0/24"
    }
  ]

  # Dedicated security group for the VSI
  create_security_group = true
  security_group = {
    name = "${var.prefix}-vsi-sg"
    rules = [
      {
        name      = "allow-ssh"
        direction = "inbound"
        source    = "0.0.0.0/0"
        protocol  = "tcp"
        port_min  = 22
        port_max  = 22
      },
      {
        name      = "allow-http"
        direction = "inbound"
        source    = "0.0.0.0/0"
        protocol  = "tcp"
        port_min  = 80
        port_max  = 80
      },
      {
        name      = "allow-all-outbound"
        direction = "outbound"
        source    = "0.0.0.0/0"
      }
    ]
  }

  # Public Application Load Balancer — exposes Nginx on port 80
  load_balancers = [
    {
      name              = "${var.prefix}-alb"
      type              = "public"
      listener_port     = 80
      listener_protocol = "http"
      connection_limit  = 0
      algorithm         = "round_robin"
      protocol          = "http"
      health_delay      = 10
      health_retries    = 3
      health_timeout    = 5
      health_type       = "http"
      pool_member_port  = "80"

      security_group = {
        name = "${var.prefix}-alb-sg"
        rules = [
          {
            name      = "allow-http-inbound"
            direction = "inbound"
            source    = "0.0.0.0/0"
            protocol  = "tcp"
            port_min  = 80
            port_max  = 80
          },
          {
            name      = "allow-all-outbound"
            direction = "outbound"
            source    = "0.0.0.0/0"
          }
        ]
      }
    }
  ]

  resource_tags = var.resource_tags
}

# -----------------------------------------------------------------------------
# cloud-init: install Nginx and serve a Hello World page
# The landing-zone-vsi module expects cloud-init YAML (yamldecode-able).
# -----------------------------------------------------------------------------
locals {
  nginx_user_data = <<-EOT
    #cloud-config
    package_update: true
    packages:
      - nginx
    runcmd:
      - systemctl enable nginx
      - systemctl start nginx
      - |
        cat > /var/www/html/index.html <<'HTML'
        <!DOCTYPE html>
        <html>
          <head><title>Hello World</title></head>
          <body>
            <h1>Hello World from IBM Cloud VSI</h1>
            <p>Deployed via Terraform + HCP Vault</p>
          </body>
        </html>
        HTML
  EOT
}
